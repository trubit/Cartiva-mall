{
  "name": "truson-shopping-mail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run kill:ports && concurrently --kill-others-on-fail -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "node scripts/kill-client-port.mjs && node scripts/wait-server.mjs && vite",
    "dev:server": "tsx watch server/src/index.ts",
    "client": "vite",
    "server": "tsx watch server/src/index.ts",
    "kill:ports": "node scripts/kill-ports.mjs",
    "build": "tsc -b && vite build",
    "build:server": "tsc -b tsconfig.server.json --force",
    "start": "node dist/server/server/src/index.js",
    "start:server": "node dist/server/server/src/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:server": "vitest run --config vitest.config.server.ts",
    "test:server:watch": "vitest --config vitest.config.server.ts",
    "test:server:coverage": "vitest run --coverage --config vitest.config.server.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test",
    "sonar": "sonar-scanner-npm"
  },
  "dependencies": {
