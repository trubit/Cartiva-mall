# ==============================================================================
# SECRETS TEMPLATE — DO NOT COMMIT REAL CREDENTIALS
# Populate this file in your deployment environment or inject via ExternalSecrets/Vault
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: cartiva-secrets
  namespace: cartiva
  labels:
    app.kubernetes.io/name: cartiva-secrets
    app.kubernetes.io/part-of: cartiva-mall
type: Opaque
stringData:
  MONGODB_URI: "mongodb+srv://<username>:<password>@cluster.mongodb.net/cartiva?retryWrites=true&w=majority"
  REDIS_URL: "rediss://:<password>@redis-cluster:6379"
  JWT_ACCESS_SECRET: "replace-with-secure-jwt-access-secret-min-32-chars"
  JWT_REFRESH_SECRET: "replace-with-secure-jwt-refresh-secret-min-32-chars"
  PAYSTACK_SECRET_KEY: "sk_live_placeholder"
  STRIPE_SECRET_KEY: "sk_live_placeholder"
  CLOUDINARY_CLOUD_NAME: "placeholder"
  CLOUDINARY_API_KEY: "placeholder"
  CLOUDINARY_API_SECRET: "placeholder"
