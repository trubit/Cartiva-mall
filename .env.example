# ============================================================
# CARTIVA MALL — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Instructions:
# 1. Copy this file to .env or .env.production
# 2. Fill in the values for your specific deployment environment
# 3. DO NOT commit actual secrets or credentials to source control
# ============================================================

# --- App & Server Configuration -----------------------------
NODE_ENV=production
PORT=5001
CLIENT_URL=https://your-cartiva-domain.com
FRONTEND_URL=https://your-cartiva-domain.com

# --- Database (MongoDB) -------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cartiva?retryWrites=true&w=majority

# --- Cache & Distributed Queue (Redis) -----------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# --- Authentication & Session Security (JWT) ----------------
# Generate strong 64-byte hex keys: openssl rand -hex 64
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Email Notifications (SMTP / Brevo) ---------------------
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM=Cartiva <no-reply@your-cartiva-domain.com>
BREVO_API_KEY=your_brevo_api_key_here

# --- Media Storage (Cloudinary) -----------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# --- Payment Gateway (Paystack) -----------------------------
# Get API keys from: https://dashboard.paystack.com -> Settings -> API Keys
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_CURRENCY=NGN

# --- Social Authentication (Google OAuth) -------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Marketplace Commission & Fees --------------------------
# Commission rates & seller fees are dynamically managed in MongoDB via Admin Settings -> Commission Policy

# --- Initial Super Admin Account ----------------------------
ADMIN_EMAIL=admin@your-cartiva-domain.com
